<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DreamLiteApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DreamLiteRvc">

        <!-- QNN HTP's stub chain dlopens these vendor/system libs by soname at
             deviceCreate. Without the declaration the app's linker namespace
             (clns) refuses to resolve them even by absolute path, and
             deviceCreate dies with "library not found in namespace clns-15".
             Required=false so the app still installs on devices lacking them. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DreamLiteRvc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RvcLiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
