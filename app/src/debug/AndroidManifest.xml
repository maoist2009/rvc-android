<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <receiver
            android:name="com.dreamlite.rvc.SmokeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dreamlite.rvc.RUN_SMOKE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.dreamlite.rvc.PipelineReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dreamlite.rvc.RUN_PIPELINE" />
                <action android:name="com.dreamlite.rvc.RUN_REALTIME" />
                <action android:name="com.dreamlite.rvc.RUN_CONVERT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
